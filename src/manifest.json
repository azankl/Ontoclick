{
  "name": "OntoClick",
  "description": "Turn your clinical description into a proper ontology term.",
  "version": "2.0.0",
  "background": {
    "service_worker": "static/js/background.js"
  },
  "manifest_version": 3,
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "static/img/rdf_flyer.png",
    "128": "static/img/rdf_flyer.png"
  },
  "action": {
    "default_title": "Ontoclick",
    "default_popup": "index.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "static/js/*",
        "static/css/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "contextMenus",
    "clipboardWrite",
    "activeTab",
    "scripting"
  ]
}
